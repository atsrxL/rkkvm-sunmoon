-    } else if (packet->request == 0x0B) {
-      // set hid protocol request
-      prepare_ep0_data(NULL, 0);
-      res = 0;
-    }
-  } else if (packet->request_type == (USB_REQ_REC_EP)) {
-      prepare_ep0_data(NULL, 0);
-      res = 0;
-  }
-
-  return res;
-}
